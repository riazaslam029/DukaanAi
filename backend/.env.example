# DukaanAI Environment Configuration
APP_NAME=DukaanAI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# SQLite Database
DATABASE_URL=sqlite:///./dukaan.db

# Store Settings Defaults
DEFAULT_STORE_NAME=Bismillah Kiryana & General Store
DEFAULT_CURRENCY=PKR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_LOW_STOCK_THRESHOLD=5

# AI Service Configuration (Phase 2 Gemma / Ollama integration)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
